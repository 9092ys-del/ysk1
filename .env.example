# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ICONCAFE_SESSION_SECRET: HMAC secret for signing staff session tokens.
ICONCAFE_SESSION_SECRET="change-this-session-secret"

# ICONCAFE_ADMIN_ID: Initial administrator ID for /staff login.
ICONCAFE_ADMIN_ID="admin"

# ICONCAFE_ADMIN_PASSCODE: Initial administrator passcode for /staff login.
ICONCAFE_ADMIN_PASSCODE="icon2026!"
